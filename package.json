{
  "name": "loopkeeper",
  "version": "0.1.0",
  "description": "A company brain for teams whose customers live on WhatsApp, not Jira. Powered by FalkorDB.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node --watch --import tsx src/server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "node --import tsx src/server/index.ts",
    "db:up": "docker compose up -d falkordb",
    "db:check": "tsx scripts/check-falkordb.ts",
    "data:generate": "tsx data/synthetic/generate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "chat": "node --import tsx cli/index.ts",
    "model:fetch": "node --import tsx scripts/fetch-model.ts"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@hono/node-server": "^2.1.5",
    "@huggingface/transformers": "^4.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "3d-force-graph": "^1.80.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "falkordb": "^6.8.0",
    "hono": "^4.13.13",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "three-spritetext": "^1.10.0",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "private": true,
  "engines": {
    "node": ">=20.19"
  }
}
