# FalkorDB — local Docker defaults (no auth). Use 127.0.0.1, not localhost: on Windows, localhost can resolve to
# another Redis (e.g. inside WSL). For FalkorDB Cloud, set host/port/username/password from the console.
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# Which client graph to use. The graph is named lk_<TENANT>.
TENANT=tenant

# Secret salt for hashing phone numbers. Change it in every deployment.
ID_HASH_SALT=change-me

# LLM: Groq (free tier works). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional overrides (any OpenAI-compatible endpoint works)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_FAST_MODEL=openai/gpt-oss-20b
# LLM_SMART_MODEL=openai/gpt-oss-120b
# Cache model replies in .cache/ so replaying the same chat is free (true/false)
# LLM_CACHE=true
# Embeddings run locally (no key needed); downloaded once on first use
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Nvidia
NVIDIA_API_KEY=
