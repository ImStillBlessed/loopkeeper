# Only infrastructure lives here. Keys, projects, WhatsApp groups and repositories are set in the
# dashboard (Settings) while the app runs, and stored in FalkorDB.

# FalkorDB — local Docker defaults (no auth). Use 127.0.0.1, not localhost: on Windows, localhost can resolve to
# another Redis (e.g. inside WSL). For FalkorDB Cloud, set host/port/username/password from the console.
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# Encrypts the keys saved in Settings. Set it once per deployment and keep it; changing it means re-entering keys.
APP_SECRET=change-me

# Where the desk is reachable from outside (no trailing slash). The GitHub and WhatsApp webhook URLs
# shown in the dashboard are built from it. Leave unset to use whatever address the browser opened.
# PUBLIC_URL=https://desk.ednovax.com

# Secret salt for hashing phone numbers. Change it in every deployment.
ID_HASH_SALT=change-me

# The project opened by default, and seeded with the fictional demo data on first start.
# DEFAULT_PROJECT=ednovax

# Optional fallbacks, used only when nothing is saved in Settings.
# ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=   (only for an organisation-wide key)
# GITHUB_TOKEN=
# GITHUB_WEBHOOK_SECRET=
# WhatsApp Cloud API for the support number (normally set in Settings → Connections)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_HUB_GROUP_ID=
# LLM_FAST_MODEL=claude-haiku-5-5
# LLM_SMART_MODEL=claude-haiku-5-5
# How often to check GitHub for new pull requests and pushes when there's no webhook (seconds).
# GITHUB_POLL_SECONDS=60
# Cache model replies in .cache/ so the same messages are never paid for twice (true/false).
# LLM_CACHE=true
# Embeddings run locally (no key needed); downloaded once on first use.
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
